{% comment %}
  Mostly Paired With Add-on Snippet for Evvolife - Matched to Cumin Co Reference Style
{% endcomment %}

{% assign addon_product = product.metafields.custom.mostly_paired_with.value | default: product.metafields.custom.mostly_paired_with %}
{% if addon_product == blank %}
  {% assign addon_product = collections['all'].products.first %}
{% endif %}
{% assign addon_variant = addon_product.selected_or_first_available_variant %}

{% if addon_product and addon_product.available %}
<div class="mostly-paired-section mt-20 mb-20">
  <div style="font-size: 14px; font-weight: 700; color: #181818; margin-bottom: 10px;">Mostly Paired With:</div>

  <div class="paired-card d-flex align-items-center justify-content-between p-12 mb-10" style="background: #ffffff; border: 1px solid #e9e9e9; border-radius: 8px; padding: 12px; gap: 12px; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
    <div class="d-flex align-items-center" style="gap: 12px; flex: 1;">
      <div style="width: 50px; height: 50px; border-radius: 6px; overflow: hidden; border: 1px solid #eee; flex-shrink: 0; background: #ffffff;">
        <img src="{{ addon_product.featured_image | image_url: width: 100 }}" alt="{{ addon_product.title | escape }}" style="width:100%; height:100%; object-fit:cover; display:block;" />
      </div>
      <div>
        <div style="font-size: 13px; font-weight: 700; color: #181818; line-height: 1.3;">{{ addon_product.title | truncatewords: 6 }}</div>
        <div style="font-size: 13px; color: #666; margin-top: 2px;">
          <strong style="color: #181818;">{{ addon_variant.price | money }}</strong>
          {% if addon_variant.compare_at_price > addon_variant.price %}
            <s style="color: #999; margin-left: 4px; font-size: 12px;">{{ addon_variant.compare_at_price | money }}</s>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="paired-checkbox-wrap" style="flex-shrink: 0;">
      <label class="custom-paired-label" style="position: relative; cursor: pointer; display: flex; align-items: center; margin: 0;">
        <input type="checkbox" class="paired-addon-checkbox" data-variant-id="{{ addon_variant.id }}" data-price="{{ addon_variant.price }}" style="display: none;" />
        <span class="custom-paired-box" style="width: 22px; height: 22px; border: 2px solid #908bc3; border-radius: 4px; display: flex; align-items: center; justify-content: center; background: #ffffff; transition: all 0.2s;">
          <i class="zmdi zmdi-check custom-paired-icon" style="font-size: 15px; color: #ffffff; display: none;"></i>
        </span>
      </label>
    </div>
  </div>
</div>

<style>
  .paired-addon-checkbox:checked + .custom-paired-box {
    background-color: #908bc3 !important;
    border-color: #908bc3 !important;
  }
  .paired-addon-checkbox:checked + .custom-paired-box .custom-paired-icon {
    display: block !important;
  }
</style>

<script>
  (function() {
    function initPairedAddon() {
      var checkboxes = document.querySelectorAll('.paired-addon-checkbox');
      if (!checkboxes.length) return;

      var mainPriceCents = {{ product.selected_or_first_available_variant.price }};
      // NOTE: id="AddToCart" is duplicated on the page (main form + sticky bar),
      // so getElementById would only ever bind the first one and the sticky
      // button would silently ignore the checked add-ons.
      var buttons = document.querySelectorAll('.btnAddToCart');

      function formatMoney(cents) {
        if (typeof Shopify !== 'undefined' && Shopify.formatMoney && typeof theme !== 'undefined') {
          return Shopify.formatMoney(cents, theme.moneyFormat);
        }
        return 'Rs. ' + (cents / 100).toFixed(2);
      }

      function isSoldOut(btn) {
        var wrap = btn.closest('.product-form__item--submit');
        return !!(wrap && wrap.classList.contains('soldout'));
      }

      function labelOf(btn) {
        return btn.querySelector('[id="AddToCartText"]');
      }

      function setLabel(text) {
        buttons.forEach(function(btn) {
          if (isSoldOut(btn)) return; // leave "Notify Me" alone
          var label = labelOf(btn);
          if (label) label.innerText = text;
        });
      }

      function updateAddToCartTotal() {
        var totalCents = mainPriceCents;
        checkboxes.forEach(function(cb) {
          if (cb.checked) {
            totalCents += parseInt(cb.getAttribute('data-price') || 0, 10);
          }
        });
        setLabel('ADD TO BAG — ' + formatMoney(totalCents));
      }

      // `nuranium` is declared with `var` inside the IIFE in nuranium.js and is
      // never attached to window, so window.nuranium.initMiniCart() is a no-op.
      // Refresh the drawer the same way the theme's own ajaxProductAddToCart does.
      function refreshCartDrawer() {
        if (typeof jQuery === 'undefined') {
          window.location.href = '/cart';
          return;
        }

        jQuery.get('/cart?view=json', function(html) {
          jQuery('#cart-info').html(html);
        }).always(function() {
          jQuery.getJSON('/cart.js', function(cart) {
            jQuery('.CartCount, #CartCountCavas').text(cart.item_count);
            jQuery('#header-cart-total').html(formatMoney(cart.total_price));
            jQuery('.cart-popup-heading span').html('There are ' + cart.item_count + ' item(s) in your cart');
            jQuery('#desktop_cart').toggleClass('item_count', cart.item_count > 0);
          });
          // Open the drawer only after its markup has been replaced.
          jQuery('#desktop_cart').addClass('active');
          jQuery('.sidebar-overlay').addClass('act');
          jQuery('body').addClass('cart_popup_opened');
        });
      }

      checkboxes.forEach(function(cb) {
        cb.addEventListener('change', updateAddToCartTotal);
      });

      updateAddToCartTotal();

      buttons.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var checkedAddons = [];
          checkboxes.forEach(function(cb) {
            if (cb.checked) {
              checkedAddons.push(parseInt(cb.getAttribute('data-variant-id'), 10));
            }
          });

          if (!checkedAddons.length) return; // nothing paired: let the theme handle it

          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();

          // Read id/quantity from THIS button's own form so the sticky bar posts
          // its own variant and quantity instead of the main form's.
          var form = btn.closest('form');
          var idInput = form && form.querySelector('[name="id"]');
          var qtyInput = form && form.querySelector('[name="quantity"]');
          var mainVariantId = idInput ? parseInt(idInput.value, 10) : {{ product.selected_or_first_available_variant.id }};
          var qty = qtyInput ? (parseInt(qtyInput.value, 10) || 1) : 1;

          var items = [{ id: mainVariantId, quantity: qty }];
          checkedAddons.forEach(function(vid) {
            items.push({ id: vid, quantity: 1 });
          });

          setLabel('ADDING...');

          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items })
          })
          .then(function(res) {
            // fetch only rejects on network failure: /cart/add.js returns 422 for
            // sold-out or stale variants, which would otherwise look like success.
            return res.json().then(function(data) {
              if (!res.ok) {
                throw new Error(data.description || data.message || 'Add to cart failed');
              }
              return data;
            });
          })
          .then(function() {
            updateAddToCartTotal();
            refreshCartDrawer();
          })
          .catch(function(err) {
            updateAddToCartTotal();
            console.error('[paired-addon] add to cart failed:', err);
            alert(err.message || 'Sorry, this item could not be added to your cart.');
          });
        }, true);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPairedAddon);
    } else {
      initPairedAddon();
    }
  })();
</script>
{% endif %}
