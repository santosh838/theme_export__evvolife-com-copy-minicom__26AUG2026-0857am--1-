{% comment %}
  Pincode Delivery & City Estimator Snippet for Evvolife - Single Line Format
{% endcomment %}

<div class="product-pincode-checker" style="background: #ffffff; border: 1px solid #e9e9e9; border-radius: 10px; padding: 14px 16px; margin-top: 15px; margin-bottom: 15px; box-shadow: 0 2px 8px rgba(0,0,0,0.02); box-sizing: border-box; clear: both;">
  <div class="d-flex align-items-center" style="gap: 8px; margin-bottom: 10px;">
    <div style="width: 28px; height: 28px; border-radius: 50%; background: #f0eef8; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
      <i class="zmdi zmdi-truck" style="font-size: 15px; color: #908bc3;"></i>
    </div>
    <span style="font-size: 13px; font-weight: 700; color: #181818; letter-spacing: -0.2px;">Check Delivery & Servicability</span>
  </div>

  <div class="pincode-input-wrap d-flex align-items-center" style="gap: 8px; position: relative;">
    <input
      type="text"
      id="pincode-input"
      placeholder="Enter 6-digit Pincode (e.g. 382715)"
      maxlength="6"
      style="flex: 1; height: 38px; padding: 0 12px; border: 1.5px solid #e0e0e0; border-radius: 6px; font-size: 13px; outline: none; background: #fafafa; color: #181818; transition: border-color 0.2s;"
      onfocus="this.style.borderColor='#908bc3'; this.style.background='#ffffff';"
      onblur="this.style.borderColor='#e0e0e0'; this.style.background='#fafafa';"
    />
    <button
      type="button"
      id="pincode-check-btn"
      disabled
      style="height: 38px; padding: 0 18px; background: #908bc3; color: #ffffff; border: none; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: not-allowed; opacity: 0.5; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.2s; flex-shrink: 0;"
    >
      Check
    </button>
  </div>

  <div id="pincode-result-msg" style="font-size: 13px; line-height: 1.5; display: none;"></div>
</div>

{% assign min_days = section.settings.pincode_min_days | default: 3 %}
{% assign max_days = section.settings.pincode_max_days | default: 5 %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var checkBtn = document.getElementById('pincode-check-btn');
    var pinInput = document.getElementById('pincode-input');
    var resultMsg = document.getElementById('pincode-result-msg');

    if (checkBtn && pinInput) {
      function validateInput() {
        var pin = pinInput.value.trim();
        if (pin.length === 6 && !isNaN(pin)) {
          checkBtn.disabled = false;
          checkBtn.style.opacity = '1';
          checkBtn.style.cursor = 'pointer';
        } else {
          checkBtn.disabled = true;
          checkBtn.style.opacity = '0.5';
          checkBtn.style.cursor = 'not-allowed';
        }
      }

      pinInput.addEventListener('input', validateInput);

      checkBtn.addEventListener('click', function() {
        var pin = pinInput.value.trim();
        if (pin.length !== 6 || isNaN(pin)) return;
        
        checkBtn.innerText = 'VERIFYING...';
        checkBtn.disabled = true;
        checkBtn.style.opacity = '0.7';

        fetch('https://api.postalpincode.in/pincode/' + pin)
          .then(function(res) { return res.json(); })
          .then(function(data) {
            checkBtn.innerText = 'CHECK';
            validateInput();

            if (data && data[0] && data[0].Status === 'Success' && data[0].PostOffice && data[0].PostOffice.length > 0) {
              var po = data[0].PostOffice[0];
              var locationName = po.District;
              displayResult(pin, locationName);
            } else {
              resultMsg.style.display = 'block';
              resultMsg.innerHTML = 
                '<div style="background: #fdf2f0; border: 1px solid #f5c6cb; border-radius: 6px; padding: 8px 10px; color: #d16b54; font-size: 12px; font-weight: 600; margin-top: 10px;">' +
                  '<i class="zmdi zmdi-close-circle" style="margin-right: 4px;"></i> Pincode <strong>' + pin + '</strong> is invalid or not serviceable.' +
                '</div>';
            }
          })
          .catch(function(err) {
            checkBtn.innerText = 'CHECK';
            validateInput();
            displayResult(pin, 'India');
          });
      });

      pinInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter' && !checkBtn.disabled) {
          e.preventDefault();
          checkBtn.click();
        }
      });
    }

    function displayResult(pin, locationName) {
      var minDays = {{ min_days }};
      var maxDays = {{ max_days }};

      resultMsg.style.display = 'block';
      resultMsg.innerHTML = 
        '<div style="background: #f4f8f3; border: 1px solid #d2e5d0; border-radius: 8px; padding: 10px 12px; margin-top: 10px; display: flex; align-items: center; justify-content: space-between;">' +
          '<div style="font-size: 12px; color: #181818;">' +
            '<strong style="color: #2e6b29;">Delivery in ' + minDays + '-' + maxDays + ' days</strong> to ' + locationName + ' ' + pin +
          '</div>' +
          '<button type="button" id="pincode-reset-btn" style="background: #ffffff; border: 1px solid #908bc3; color: #908bc3; border-radius: 10px; padding: 2px 10px; font-size: 10px; font-weight: 700; cursor: pointer; flex-shrink: 0; margin-left: 8px;">Change</button>' +
        '</div>';

      var resetBtn = document.getElementById('pincode-reset-btn');
      if (resetBtn) {
        resetBtn.addEventListener('click', function() {
          pinInput.value = '';
          validateInput();
          resultMsg.style.display = 'none';
          resultMsg.innerHTML = '';
        });
      }
    }
  });
</script>
