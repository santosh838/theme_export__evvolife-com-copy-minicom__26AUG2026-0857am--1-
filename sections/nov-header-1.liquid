{{ 'css-header1.css' | asset_url | stylesheet_tag }}
{% assign sst = section.settings %}
{% style -%}
  @media(min-width: 768px) {
    .site-header__logo {
      max-width: {{ sst.w_logo_md }}px;
    }
  }
  @media(min-width: 992px) {
    .site-header__logo {
      max-width: {{ sst.w_logo_lg }}px;
    }
  }
  @media(min-width: 1200px) {
    .site-header__logo {
      max-width: {{ sst.w_logo }}px;
    }
  }
  .site-header .WishlistCount {
    color: {{ sst.wishlist_badge_color }};
    background: {{ sst.wishlist_badge_bg }};
  }
  .site-header .site-header__cart .site-header__cart-count {
    color: {{ sst.cart_badge_color }};
    background: {{ sst.cart_badge_bg }};
  }
  .site-header__search {
    --search-input-color: {{ sst.search_input_color }};
    --search-input-bg: {{ sst.search_input_bg }};
    --search-input-border: {{ sst.search_input_border }};
    --search-placeholder: {{ sst.search_placeholder }};
  }
{%- endstyle %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>
<header class="site-header{% if sst.stickymenu %} sticky-header{% endif %}">
  <div class="header-content position-relative header-search__parent d-none d-md-block {% if request.page_type == 'index' %}color-{{ sst.color_header }} pt-5 pb-5{% else %}color-{{ sst.color_header_page_inner }} pt-15 pb-15{% endif %}">
    <div class="{{ sst.container }}">
      <div class="d-flex align-items-center">
        <div class="header-left d-flex align-items-center">
          <div class="contentsticky_logo d-flex align-items-center">
            {% if sst.logo %}
              <a href="{{ routes.root_url }}" class="site-header__logo d-flex position-relative">
                {%- assign image_size_2x = sst.w_logo | times: 2 | at_most: 5760 -%}
                <img srcset="{{ sst.logo | image_url: width: sst.w_logo }} 1x, {{ sst.logo | image_url: width: image_size_2x }} 2x"
                  src="{{ sst.logo | image_url: width: sst.w_logo | append: 'x' }}"
                  class="w-100 img-fluid" 
                  alt="{{ sst.logo.alt | default: shop.name | escape }}"
                  width="{{ sst.logo.width }}"
                  height="{{ sst.logo.height }}"
                >
              </a>
            {% else %}
              <div class="h4 site-header__logo d-inline-block mb-0"><a class="site-header__logo-link" href="{{ routes.root_url }}" itemprop="url">{{ shop.name }}</a></div>
            {% endif %}
          </div>
        </div>
        <div class="header-right d-flex align-items-center position-relative">
          <div class="site-nav--btn d-flex align-items-center justify-content-center">
            <span class="icon"><span></span></span>
            <span class="text font-700 text-uppercase">{{ 'layout.header.menu' | t }}</span>
          </div>
          <div class="site-header__search">
            {% render 'nov-formsearch-inline' %}
          </div>
          <div class="header-group-item d-flex align-items-center"> 
            <div class="contentsticky_account pointer">
              <a href="#" class="header-icon nov_btn_act" data-toggle="header_settings" data-overlay="true" title="{{ 'layout.customer.account' | t }}">
                {% if sst.account_svg %}
                  {% render 'icon-account' %}
                {% else %}
                  <i class="{{ sst.account_icon }} position-relative"></i>
                {% endif %}
                <div class="header-label">{{ 'layout.customer.account' | t }}</div>
              </a>
            </div>
            {% if settings.wishlist_enable %}
              <div class="contentsticky_wishlist header--wishlist">
                <a href="/pages/{{ settings.link_page_wishlist }}" class="header-icon text-center" rel="nofollow" title="{{ 'layout.customer.wishlists' | t }}">
                  <span class="header-wishlist-icon d-inline-flex position-relative">
                    {% if sst.wishlist_svg %}
                      {% render 'icon-heart' %}
                    {% else %}
                      <i class="{{ sst.wishlist }} position-relative"></i>
                    {% endif %}
                    <span class="WishlistCount text-center">0</span>
                  </span>
                  <div class="header-label">{{ 'layout.customer.wishlists' | t }}</div>
                </a>
              </div>
            {% endif %}
            <div class="contentsticky_cart">
              <div id="cart_block">
                <div class="header-cart d-flex justify-content-center">
                  <div class="site-header__cart header-icon text-center pointer">
                    <div class="site-header__cart-icon position-relative" title="{{ 'layout.cart.title_cart' | t }}">
                      {% if sst.cart_svg %}
                        {% render 'icon-cart' %}
                      {% else %}
                        <i class="rbb-icon-shopping-{{ sst.cart_type }}-{{ sst.cart }} position-relative"></i>
                      {% endif %}
                      <span class="site-header__cart-count">
                        <span class="CartCount">{{ cart.item_count }}</span>
                      </span>
                    </div>
                    <div id="header-cart-total">{{ cart.total_price }}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="contentsticky_menu color-{{ sst.color_header }} d-none d-xl-block {% if request.page_type == 'index' %}color-{{ sst.color_header }} bd-b{% else %}color-{{ sst.color_header_page_inner }} bd-t{% endif %}" style="--padding-left: {{ sst.w_logo }}px">
    <div class="{{ sst.container }}">
      <nav id="AccessibleNav">{% render 'site-nav' color: sst.color_menu, mainmenu: sst.main_linklist %}</nav>
    </div>
  </div>
  <div class="header-mobile d-md-none color-{{ sst.color_header_sm }}{% if sst.stickymenu_sm %} sticky-header-mobile{% endif %}">
    <div class="header-mobile-content">
      <div class="row align-items-center h-100">
        <div class="col-3 d-flex align-items-center">
          <div id="show-megamenu" class="item-mobile-top">
            <div class="icon-directional"></div>
          </div>
          <div class="mobile-btn_search item-mobile-top">
            {% render 'icon-search' %}
            <i class="zmdi zmdi-close"></i>
          </div>
          <div id="mobile_search">
            {% render 'nov-formsearch-inline' %}
          </div>
        </div>
        <div class="mobile_logo col-6 text-center">
          {% if sst.logo_mobile %}
            <a href="{{ routes.root_url }}" class="site-header__logo-image img-fluid d-inline-block">
              {%- assign logo_alt = sst.logo_mobile.alt | default: shop.name | escape -%}
              {%- assign logo_height = sst.wm_logo | divided_by: sst.logo_mobile.aspect_ratio | round -%}
              {% capture sizes %}(max-width: {{ sst.wm_logo | times: 2 }}px) 50vw, {{ sst.wm_logo }}px{% endcapture %}
              {% capture widths %}{{ sst.wm_logo }}, {{ sst.wm_logo | times: 1.5 | round }}, {{ sst.wm_logo | times: 2 }}{% endcapture %}
              {{ sst.logo_mobile | image_url: width: 600 | image_tag:
                widths: widths,
                height: logo_height,
                width: sst.wm_logo,
                alt: logo_alt,
                sizes: sizes,
                preload: true
              }}
            </a>
          {% else %}
            <a class="site-header__logo-link" href="{{ routes.root_url }}" itemprop="url">{{ shop.name }}</a>
          {% endif %}
        </div>
        <div class="mobile_cart col-3 d-flex justify-content-end align-items-center">
          <div class="header-cart">
            <div class="site-header__cart position-relative">
              <span class="cart-count position-absolute" title="{{ 'layout.cart.title_cart' | t }}">
                <span class="CartCount">{{ cart.item_count }}</span>
              </span>
              <div class="site-header__cart-icon">
                {% if sst.cart_svg %}
                  {% render 'icon-cart' %}
                {% else %}
                  <i class="rbb-icon-shopping-{{ sst.cart_type }}-{{ sst.cart }} position-relative"></i>
                {% endif %}
              </div>
            </div>
          </div>
          {% if sst.vertical_menu != blank %}
            <div class="btn-vertical"> 
              <i class="rbb-icon-menu-4"></i>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</header>
{% if sst.stickymenu %}
  <div id="header-sticky" class="d-none d-md-block header-search__parent color-{{ sst.color_header_sticky }}">
    <div class="{{ sst.container }}">
      <div class="bl_content row align-items-center">
        <div class="col-xl-3 col-6 d-flex align-items-center">
          <div class="site-nav--btn d-flex d-xl-none align-items-center justify-content-center">
            <span class="icon"><span></span></span>
            <span class="text font-700 text-uppercase">{{ 'layout.header.menu' | t }}</span>
          </div>
          <div class="contentstickynew_logo d-flex align-items-center justify-content-center"></div>
        </div>
        <div class="col-md-6 d-none d-xl-flex align-items-center justify-content-center">
          <div class="contentstickynew_menu"></div>
        </div>
        <div class="col-xl-3 col-6 d-flex align-items-center justify-content-end">
          <div class="header-group-item d-flex align-items-center justify-content-end">
            <div class="contentstickynew_search"></div>
            <div class="contentstickynew_account"></div>
            {% if settings.wishlist_enable %}
              <div class="contentstickynew_wishlist"></div>
            {% endif %}
            <div class="contentstickynew_cart"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}
<div class="d-none"><nav id="AccessibleNavMobile">{% render 'site-nav-mobile', mainmenu: sst.main_linklist %}</nav></div>
