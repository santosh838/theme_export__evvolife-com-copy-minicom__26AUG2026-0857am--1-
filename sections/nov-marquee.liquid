{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .block-marquee-item {
    animation-duration: {{ sst.time }}s;
    --spacing: {{ sst.spacing | divided_by: 10.0 }}rem;
    --spacing-sm: {{ sst.spacing_sm | divided_by: 10.0 }}rem;
  }
  #shopify-section-{{ section.id }} .shopify-block {
    background-color: {{ sst.item_bg }};
    border-radius: {{ sst.item_corner }}px;
    padding: {{ sst.item_padding_vertical }}% {{ sst.item_padding_horizontal }}%;
    overflow: hidden;
    transform: translateZ(0);
  }
  {% if sst.item_width == 'custom' %}
    #shopify-section-{{ section.id }} .shopify-block {
      width: {{ sst.xs }}px;
      flex: 0 0 {{ sst.xs }}px;
    }
    @media(min-width:  576px) {
      #shopify-section-{{ section.id }} .shopify-block {
        width: {{ sst.sm }}px;
        flex: 0 0 {{ sst.sm }}px;
      }
    }
    @media(min-width:  768px) {
      #shopify-section-{{ section.id }} .shopify-block {
        width: {{ sst.md }}px;
        flex: 0 0 {{ sst.md }}px;
      }
    }
    @media(min-width:  992px) {
      #shopify-section-{{ section.id }} .shopify-block {
        width: {{ sst.lg }}px;
        flex: 0 0 {{ sst.lg }}px;
      }
    }
    @media(min-width:  1200px) {
      #shopify-section-{{ section.id }} .shopify-block {
        width: {{ sst.xl }}px;
        flex: 0 0 {{ sst.xl }}px;
      }
    }
    @media(min-width:  1441px) {
      #shopify-section-{{ section.id }} .shopify-block {
        width: {{ sst.xxl }}px;
        flex: 0 0 {{ sst.xxl }}px;
      }
    }
  {% endif %}
{% endstyle %}
<div class="color-{{ sst.color_section }}{{ bg_class_full }}{% if sst.animate %} wow fadeInUp{% endif %}">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      <div class="nov-marquee overflow_hidden d-flex{% if sst.show_dot %} show-dots{% endif %}{% if sst.marquee_reverse %} marquee-reverse{% endif %}">
        <div class="block-marquee-item d-flex">
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "Vinova Marquee",
    "settings": [
      {
        "type": "checkbox",
        "id": "marquee_reverse",
        "label": "Marquee reverse",
        "info": "Enable to reverse the marquee direction"
      },
      {
        "type": "range",
        "id": "time",
        "min": 5,
        "max": 60,
        "step": 1,
        "unit": "s",
        "label": "Slide run time",
        "default": 10
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "px",
        "label": "Spacing",
        "default": 30
      },
      {
        "type": "range",
        "id": "spacing_sm",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "px",
        "label": "Spacing mobile",
        "default": 10
      },
      {
        "type": "checkbox",
        "id": "show_dot",
        "label": "Show dots",
        "default": true
      },
      {
        "type": "select",
        "id": "item_width",
        "label": "Item width",
        "options": [
          {
            "value": "auto",
            "label": "Auto"
          },
          {
            "value": "custom",
            "label": "Custom (px)"
          }
        ],
        "default": "auto"
      },
      {
        "type": "number",
        "id": "xxl",
        "label": "Desktop",
        "default": 345,
        "info": "Breakpoint 1441px ↑",
        "visible_if": "{{ section.settings.item_width == 'custom' }}"
      },
      {
        "type": "number",
        "id": "xl",
        "label": "Large laptop",
        "default": 300,
        "info": "Breakpoint 1200px ↑",
        "visible_if": "{{ section.settings.item_width == 'custom' }}"
      },
      {
        "type": "number",
        "id": "lg",
        "label": "Laptop",
        "default": 275,
        "info": "Breakpoint 992px ↑",
        "visible_if": "{{ section.settings.item_width == 'custom' }}"
      },
      {
        "type": "number",
        "id": "md",
        "label": "Tablet",
        "default": 250,
        "info": "Breakpoint 768px ↑",
        "visible_if": "{{ section.settings.item_width == 'custom' }}"
      },
      {
        "type": "number",
        "id": "sm",
        "label": "Large mobile",
        "default": 200,
        "info": "Breakpoint 576px ↑",
        "visible_if": "{{ section.settings.item_width == 'custom' }}"
      },
      {
        "type": "number",
        "id": "xs",
        "label": "Mobile",
        "default": 200,
        "info": "Breakpoint 575px ↓",
        "visible_if": "{{ section.settings.item_width == 'custom' }}"
      },
      {
        "type": "header",
        "content": "Style Item"
      },
      {
        "type": "color",
        "id": "item_bg",
        "label": "Item background",
        "default": "#d5d5d5"
      },
      {
        "type": "range",
        "id": "item_corner",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Item corner",
        "default": 5
      },
      {
        "type": "range",
        "id": "item_padding_horizontal",
        "label": "Item padding horizontal",
        "default": 2,
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "%",
        "info": "Item padding horizontal"
      },
      {
        "type": "range",
        "id": "item_padding_vertical",
        "label": "Item padding vertical",
        "default": 2,
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "%",
        "info": "Item padding vertical"
      },
      {
        "type":  "header",
        "content": "Section Style"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default":   true
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          {"value": "container", "label": "Container"},
          {"value": "container-fluid", "label": "Container fluid"},
          {"value": "container-full", "label": "Container full width"}
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_section",
        "label": "Color section",
        "default": "background-1"
      },
      {
        "type": "text",
        "id": "class_section",
        "label": "Class"
      },
      {
        "type":  "header",
        "content": "Section Background"
      },
      {
        "type": "checkbox",
        "id": "ss_bg_enable",
        "label": "Enable"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colors",
        "default": "#ffffff",
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image",
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "select",
        "id": "background_img_size",
        "label": "Background image size",
        "default": "cover",
        "options": [
          { "value": "auto", "label": "Auto" },
          { "value": "cover", "label": "Cover" },
          { "value": "contain", "label": "Contain" }
        ],
        "visible_if": "{{ section.settings.ss_bg_enable == true and section.settings.background_image != blank }}"
      },
      {
        "type": "checkbox",
        "id": "enable_background_img_size_custom",
        "label": "Enable background image size custom",
        "visible_if": "{{ section.settings.ss_bg_enable == true and section.settings.background_image != blank }}"
      },
      {
        "type": "text",
        "id": "background_img_size_custom",
        "label": "Background image size custom",
        "info": "Replace base background size, unit % or px",
        "visible_if": "{{ section.settings.background_image != blank and section.settings.enable_background_img_size_custom == true }}"
      },
      {
        "type": "select",
        "id": "background_img_position",
        "label": "Background image position",
        "default": "center center",
        "options": [
          { "value": "top left", "label": "Top left" },
          { "value": "top center", "label": "Top center" },
          { "value": "top right", "label": "Top right" },
          { "value": "center left", "label": "Center left" },
          { "value": "center center", "label": "Center middle" },
          { "value": "center right", "label": "Center right" },
          { "value": "bottom left", "label": "Bottom left" },
          { "value": "bottom center", "label": "Bottom center" },
          { "value": "bottom right", "label": "Bottom right" }
        ],
        "visible_if": "{{ section.settings.background_image != blank }}"
      },
      {
        "type": "range",
        "id": "background_corner",
        "min": 0,
        "max": 50,
        "step": 1,
        "label": "Corner background",
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "select",
        "id": "background_position",
        "label": "Background position",
        "default": "bg-center",
        "options": [
          { "value": "bg-top", "label": "Top" },
          { "value": "bg-center", "label": "Center" },
          { "value": "bg-bottom", "label": "Bottom" }
        ],
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "select",
        "id": "background_size",
        "label": "Background size",
        "default": "full",
        "options": [
          { "value": "full", "label": "Full" },
          { "value": "contain", "label": "Contain"}
        ],
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "range",
        "id": "background_padding_horizontal",
        "label": "Background size contain padding horizontal",
        "min": 0,
        "max": 20,
        "step": 1,
        "default": 1,
        "unit": "%",
        "info": "Breakpoint 1200px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "range",
        "id": "height_background_xxl",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 1441px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "range",
        "id": "height_background_xl",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 1200px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "range",
        "id": "height_background_lg",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 992px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "range",
        "id": "height_background_md",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 768px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "range",
        "id": "height_background_sm",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 576px ↑",
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "range",
        "id": "height_background_xs",
        "min": 10,
        "max": 100,
        "step": 1,
        "label": "Height background",
        "default": 100,
        "unit": "%",
        "info": "Breakpoint 575px ↓",
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "distance_top_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_top_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "distance_top_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_top_sm",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "distance_bottom_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "distance_bottom_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "distance_bottom_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "distance_bottom_sm",
        "label": "Mobile",
        "default": 30
      }
    ],
    "blocks": [
      {
        "type": "text"
      },
      {
        "type": "image"
      },
      {
        "type": "button"
      },
      {
        "type": "card"
      },
      {
        "type": "@app"
      }
    ],
    "presets": [
      {
        "name": "Vinova Marquee",
        "category": "Text",
        "blocks": [
          {
            "type": "text"
          },
          {
            "type": "text"
          },
          {
            "type": "text"
          }
        ]
      }
    ]
  }
{% endschema %}