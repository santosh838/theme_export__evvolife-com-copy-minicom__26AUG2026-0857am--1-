{%- liquid
  assign sst = section.settings
  assign collection_blog = blogs[sst.blog]
  assign blog_limit = sst.limit

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if sst.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}
{%- style -%}
  {% render 'nov-section-style' %}
  
  #shopify-section-{{ section.id }} .article__list-image-container {
    border-radius: {{ sst.item_corner_radius }}px;
  }
  #shopify-section-{{ section.id }} .item_bg_color .article--listing {
    border-radius: {{ sst.item_corner_radius }}px;
    background-color: {{ sst.item_bg_color }};
  }
  {% if sst.show_nav %}
    #shopify-section-{{ section.id }} .nav-arrow {
      --slider-arrow-color: {{ sst.slider_arrow_color }};
      --slider-arrow-color-act: {{ sst.slider_arrow_color_act }};
    }
  {% endif %}
  {% if sst.show_overlay_right %}
    #shopify-section-{{ section.id }} .overflow-right {
      --background-overlay: {{ sst.overlay_right_color }};
    }
  {% endif %}
{%- endstyle -%}

<div class="container-outer{{ bg_class_full }} color-{{ sst.color_section }}{% if sst.right_overflow %} overflow-right{% if sst.show_overlay_right %} overlay-right{% endif %}{% endif %}" data-section-id="{{ section.id }}" data-section-type="nov-swiper">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      {% if sst.show_nav or sst.show_dots %}
        <div class="d-md-flex align-items-center justify-content-between mb-55 mb-sm-20">
          {% render 'heading-section', sub_position: sst.subheading_position, class: 'mb-0' %}
          <div class="d-flex align-items-center {{ sst.dots_color }} mt-sm-30">
            {% if sst.show_nav %}
              <div class="nav-arrow nav-prev pointer">
                {% render 'icon-arrow-left' %}
              </div>
            {% endif %}
            {% if sst.show_dots %}
              <div class="swiper-pagination"></div>
            {% endif %}
            {% if sst.show_nav %}
              <div class="nav-arrow nav-next pointer">
                {% render 'icon-arrow-right' %}
              </div>
            {% endif %}
          </div>
        </div>
      {% else %}
        {% render 'heading-section', sub_position: sst.subheading_position %}
      {% endif %}
      <div class="nov-swiper-carousel swiper{% if sst.show_item_bg_color %} item_bg_color{% endif %}{% if sst.item_bg_shadow %} item_shadow{% endif %}"
        data-autoplay="false" 
        data-loop="false"
        data-dots="{{ sst.show_dots }}"
        data-nav="{{ sst.show_nav }}"
        data-row_mobile="1"
        data-items_xxl="{{ sst.xxl }}"
        data-items_xl="{{ sst.xl }}"
        data-items_lg="{{ sst.lg }}"
        data-items_md="{{ sst.md }}"
        data-items_sm="{{ sst.sm }}"
        data-items_xs="1"
        data-spacing="{{ sst.spacing }}">
          <div class="swiper-wrapper">
            {% for article in collection_blog.articles limit: blog_limit %}
              <div class="swiper-slide item">
                <div class="article--listing overflow_hidden{% if sst.animate %} wow fadeInUp{% endif %}" data-wow-delay="{{ forloop.index | times: 0.1 }}s">
                  {% if sst.show_image and article.image %}
                    <div class="article__list-image-container position-relative overflow_hidden">
                      <a href="{{ article.url }}">
                        {% render 'nov-aspect-image', image: article.image, aspect: 70 %}
                      </a>
                      {% if sst.blog_show_type %}
                        <a href="{{ collection_blog.url }}" class="article__type btn hover-ef color-{{ sst.type_color }}">
                          <span>{{ collection_blog.title }}</span>
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}
                  <div class="media-body pt-25">
                    {% if sst.blog_show_author %}
                      <div class="article_cs d-flex align-items-center color-text mb-10">
                        {% if sst.blog_show_author %}
                          <span class="article__author">
                            <span>{{ 'sections.blog.by_author' | t }} &nbsp;</span>
                            <i class="rbb-icon-human-user-10"></i>
                            <span class="font-700 color-title">{{ article.author }}</span>
                          </span>
                        {% endif %}
                        {% if sst.blog_show_date %}
                          <span class="article__date">
                            {{ article.published_at | date: "%d" }}{{ article.published_at | date: "%b" }}{{ article.published_at | date: "%Y" }}
                          </span>
                        {% endif %}
                      </div>
                    {% endif %}

                    <h2 class="article__title mb-0">
                      <a href="{{ article.url }}" class="link font-800 f_pr">{{ article.title | truncate: 70 }}</a>
                    </h2>

                    {% if sst.blog_show_excerpt %}
                      <div class="article__excerpt mt-10 color-text">
                        {% if article.excerpt.size > 0 %}
                        {{ article.excerpt | truncate: 100 }}
                        {% else %}
                        {{ article.content | strip_html | truncate: 100 }}
                        {% endif %}
                      </div>
                    {% endif %}
                    
                    {% if sst.show_readmore %}
                      <a href="{{ article.url }}" class="view_all link font-700 d-inline-flex align-items-center text-capitalize mt-25">
                        <span>{{ 'sections.button.read_more' | t }}</span>
                        <i class="zmdi zmdi-long-arrow-right"></i>
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% else %}
              {%- for i in (1..4) -%}
                {%- capture current -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
                 <div class="swiper-slide item">
                  {{ 'blog-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}
                </div>
              {%- endfor -%}
            {% endfor %}
          </div>
      </div>
      {% if sst.show_view_all_blog %}
        <div class="d-flex justify-content-center mt-60">
          <a href="{{ collection_blog.url }}" class="btn btn-large">
            <span>{{ 'sections.blog.view_all_blog' | t }}</span>
            <span class="zmdi zmdi-long-arrow-right"></span>
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
