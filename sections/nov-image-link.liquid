{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if section.settings.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}
{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .collec-img__item {
    border-radius: {% if sst.border_radius_round %}9999999px{% else %}{{ sst.border_radius }}px{% endif %};
    background-color: {{ sst.bg_img }};
    padding: {{ sst.item_py }}% {{ sst.item_px }}%;
    {% if sst.show_border -%}
      border: 1px {{ sst.style_border }} {{ sst.c_border }};
    {%- endif %}
    {% if sst.item_max_width %}
      max-width: {{ sst.item_width }}px;
      margin: auto;
    {% endif %}
  }
  
  #shopify-section-{{ section.id }} .block-image {
    border-radius: {{ sst.img_corner }}px;
    transform: translateZ(0);
    overflow: hidden;
  }
  {% if sst.enable_img_width %}
    #shopify-section-{{ section.id }} .block-image {
      max-width: {{ sst.img_width }}px !important;
    }
  {% endif %}
  {% if sst.enable_img_height %}
    #shopify-section-{{ section.id }} .respone_image {
      padding-top: {{ sst.img_height }}px !important;
    }
  {% endif %}
  {% if sst.enable_img_width or sst.enable_img_height %}
    #shopify-section-{{ section.id }} .block-image img {
      object-fit: {{ sst.object_fit }};
    }
  {% endif %}
  #shopify-section-{{ section.id }} .collec-img__heading {
    color: {{ sst.heading_c }};
    --color-link: {{ sst.heading_c }};
    font-size: {{ sst.heading_fz | times: 0.1 }}rem;
  }
  #shopify-section-{{ section.id }} .collec-img__desc {
    color: {{ sst.desc_c }};
    --color-link: {{ sst.desc_c }};
    font-size: {{ sst.desc_fz | times: 0.1 }}rem;
  }
  {% if sst.show_pagination_progress %}
    #shopify-section-{{ section.id }} .swiper-scrollbar {
      background: {{ sst.pagination_progress_bg }} !important;
    }
    #shopify-section-{{ section.id }} .swiper-scrollbar-drag {
      background: {{ sst.progress_bg }} !important;
    }
  {% endif %}

  {% if sst.show_nav %}
    #shopify-section-{{ section.id }} {
      --slider-arrow-color: {{ sst.slider_arrow_color }};
      --slider-arrow-color-act: {{ sst.slider_arrow_color_act }};
    }
  {% endif %}
  @media(max-width: 1440px) {
    #shopify-section-{{ section.id }} .collec-img__item {
      padding: clamp(0px, {{ sst.item_py }}%, 35px) clamp(0px, {{ sst.item_px }}%, 35px);
    }
  }
{% endstyle %}
<div class="container-outer{{ bg_class_full }}{% if sst.animate %} wow fadeInUp{% endif %}" data-section-id="{{ section.id }}" data-section-type="nov-swiper">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }} {{ sst.dots_color }}">

      {% render 'heading-section', sub_position: sst.subheading_position %}

      <div class="block-slider position-relative">
        <div class="nov-swiper-carousel swiper{% if sst.show_border %} show-border{% endif %}{% if sst.show_box_shadow %} show-box-shadow{% endif %}"
          data-autoplay="false"
          data-autoplayTimeout="6000"
          data-loop="false"
          data-row="1"
          data-items_xxl="{{ sst.xxl }}"
          data-items_xl="{{ sst.xl }}"
          data-items_lg="{{ sst.lg }}"
          data-items_md="{{ sst.md }}"
          data-items_sm="{{ sst.sm }}"
          data-items_xs="{{ sst.xs }}"
          data-spacing="{{ sst.spacing }}"
          data-spacing_mobile="{{ sst.spacing_sm }}">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% assign bst = block.settings %}
              <div class="swiper-slide sp-item">
                {% if sst.enable_bg_special %}
                  <div class="position-relative">
                    <svg class="bg-special" width="420" height="547" viewBox="0 0 420 547" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <defs>
                        <clipPath id="image-clip{{ section.id }}{{ block.id }}">
                          <path fill-rule="evenodd" clip-rule="evenodd"
                            d="M39.833 122.859C44.1623 101.629 51.611 79.4528 75.2558 63.1872C93.5133 50.6278 119.879 42.8699 147.09 38.6778C174.3 34.4858 202.613 33.5716 230.701 32.678C254.193 31.9311 278.001 31.1967 301.03 34.0182C324.06 36.8398 346.611 43.677 359.606 55.1873C373.145 67.1791 374.638 82.3509 375.704 96.7224C377.882 126.037 380.06 155.352 382.238 184.666C384.024 208.704 385.81 232.741 387.596 256.778C388.688 271.503 388.761 287.954 371.635 298.733C355.019 309.193 328.079 310.581 303.744 311.294L201.316 314.294C164.242 315.378 125.775 316.334 91.3968 308.113C37.0221 295.108 32.4993 268.911 32.1368 238.85C31.6707 200.147 31.9864 161.342 39.833 122.859Z"/>
                        </clipPath>
                      </defs>
                      <path fill-rule="evenodd" clip-rule="evenodd"
                        d="M9.24121 175.618C14.3488 134.583 23.1365 91.7197 51.0321 60.2806C72.5719 36.0049 103.678 21.01 135.78 12.9073C167.882 4.80468 201.285 3.03761 234.423 1.31042C262.138 -0.133182 290.226 -1.55274 317.395 3.90093C344.565 9.35459 371.171 22.5699 386.501 44.8179C402.474 67.9964 404.236 97.3214 405.494 125.1C408.063 181.761 410.633 238.422 413.203 295.083C415.309 341.544 417.416 388.004 419.524 434.465C420.812 462.925 420.898 494.724 400.693 515.559C381.089 535.776 349.306 538.459 320.596 539.837L199.755 545.635C156.016 547.731 110.633 549.578 70.0749 533.689C5.92493 508.551 0.589076 457.916 0.161348 399.812C-0.3885 325.005 -0.0159993 250 9.24121 175.618Z"
                        fill="{{ bst.bg_special_color }}"/>
                      <image
                        href="{{ bst.image | image_url: width: 840 }}"
                        x="32" y="32"
                        width="356"
                        height="282"
                        clip-path="url(#image-clip{{ section.id }}{{ block.id }})"
                        preserveAspectRatio="xMidYMid slice"
                      />
                    </svg>
                    <div class="collec-img__content {{ sst.block_alignment }}">
                      {% if bst.heading != blank %}
                        <div class="collec-img__heading d-inline-flex align-items-center {{ sst.heading_fw }} {{ sst.heading_ff }}">
                          {% if sst.heading_type == 'link' %}
                            <a href="{{ bst.link }}" class="d-inline-flex align-items-center">
                          {% endif %}
                            {{ bst.heading }}
                          {% if sst.heading_type == 'link' %}
                            </a>
                          {% endif %}
                        </div>
                      {% endif %}
                      {% if bst.desc != blank %}
                        <div class="collec-img__desc {{ sst.fw_desc }}{% if bst.heading != blank %} mt-10 mt-sm-5{% endif %}">{{ bst.desc }}</div>
                      {% endif %}
                      {% if sst.show_btn %}
                        <div class="collec-img__btn mt-30 mt-lg-15 color-{{ sst.btn_color }}">
                          <a href="{{ bst.link }}" class="{% if sst.btn_type == 'text' %}link d-inline-flex font-700{% else %}btn{% endif %}">
                            {% if sst.btn_type == 'text' %}
                              <span>{{ bst.btn }}</span>
                            {% else %}
                              <i class="zmdi zmdi-long-arrow-right"></i>
                            {% endif %}
                          </a>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% else %}
                  <div class="collec-img__item position-relative overflow_hidden block-{{ forloop.index }} {{ sst.type_hover }}">
                    <div class="block-image mb-25">
                      <a href="{{ bst.link }}" class="d-block{% if sst.enable_img_height %} h-100{% endif %}">
                        {% if bst.image != blank %}
                          {% render 'nov-aspect-image', image: bst.image %}
                        {% else %}
                          {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                          {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                        {% endif %}
                      </a>
                    </div>
                    <div class="collec-img__content {{ sst.block_alignment }}">
                      {% if bst.heading != blank %}
                        <div class="collec-img__heading d-inline-flex align-items-center {{ sst.heading_fz }} {{ sst.heading_fw }} {{ sst.heading_ff }}">
                          {% if sst.heading_type == 'link' %}
                            <a href="{{ bst.link }}" class="d-inline-flex align-items-center">
                          {% endif %}
                            {{ bst.heading }}
                          {% if sst.heading_type == 'link' %}
                            </a>
                          {% endif %}
                        </div>
                      {% endif %}
                      {% if bst.desc != blank %}
                        <div class="collec-img__desc {{ sst.fz_desc }} {{ sst.fw_desc }} mt-10{% if bst.btn != blank %} mb-5{% endif %}">{{ bst.desc }}</div>
                      {% endif %}
                      {% if bst.btn != blank %}
                        <div class="collec-img__btn mt-5">
                          <a href="{{ bst.link }}" class="link d-inline-flex font-700">
                            <span>{{ bst.btn }}</span>
                          </a>
                        </div>
                      {% endif %}
                      {% if sst.show_btn_arrow %}
                        <div class="mt-30">
                          <a href="{{ bst.link }}" class="btn btn-arrow">
                            <i class="zmdi zmdi-long-arrow-right"></i>
                          </a>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
          {% if sst.show_dots %}
            <div class="d-flex align-items-center justify-content-center">
              <div class="swiper-pagination mt-60 mt-sm-30"></div>
            </div>
          {% endif %}
          {% if sst.show_pagination_progress %}
            <div class="swiper-scrollbar mt-80 mt-md-40 position-static"></div>
          {% endif %}
        </div>
        {% if sst.show_nav %}
          <div class="slider-nav d-flex align-items-center justify-content-center mt-40">
            <div class="nav-arrow nav-prev pointer"></div>
            <div class="nav-arrow nav-next pointer"></div>
          </div>
        {% endif %}
      </div>

    </div>
  </div><!-- End container -->
</div>

{% schema %}
  {
    "name": "Vinova Image Link",
    "class": "section-image-link",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Vinova Image Link</p>"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#222222"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Sub heading",
        "default": "<p>Subtitle from happy customers</p>"
      },
      {
        "type": "color",
        "id": "subheading_color",
        "label": "Sub heading color",
        "default": "#666666"
      },
      {
        "type": "richtext",
        "id": "descheading",
        "label": "Description",
        "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
      },
      {
        "type": "color",
        "id": "descheading_color",
        "label": "Description color",
        "default": "#666666"
      },
      {
        "type": "select",
        "id": "subheading_position",
        "label": "Sub heading position",
        "default": "bottom",
        "options": [
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          }
        ]
      },
      {
        "type": "select",
        "id": "heading_alignment",
        "label": "Heading alignment",
        "default": "text-left",
        "options": [
          {
            "value": "text-left",
            "label": "Left"
          },
          {
            "value": "text-center",
            "label": "Center"
          },
          {
            "value": "text-right",
            "label": "Right"
          }
        ]
      },
      {
        "type":  "header",
        "content": "Item Per Row"
      },
      {
        "type": "range",
        "id": "xxl",
        "min": 1,
        "max": 10,
        "step": 1,
        "label": "Desktop",
        "default": 3,
        "info": "Breakpoint 1441px"
      },
      {
        "type": "range",
        "id": "xl",
        "min": 1,
        "max": 10,
        "step": 1,
        "label": "Large laptop",
        "default": 3,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "range",
        "id": "lg",
        "min": 1,
        "max": 8,
        "step": 1,
        "label": "Laptop",
        "default": 3,
        "info": "Breakpoint 992px"
      },
      {
        "type": "range",
        "id": "md",
        "min": 1,
        "max": 7,
        "step": 1,
        "label": "Tablet",
        "default": 3,
        "info": "Breakpoint 768px"
      },
      {
        "type": "range",
        "id": "sm",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Large mobile",
        "default": 2,
        "info": "Breakpoint 576px"
      },
      {
        "type": "range",
        "id": "xs",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile",
        "default": 2
      },
      {
        "type": "header",
        "content": "Slider Settings"
      },
      {
        "type": "range",
        "id": "spacing",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "px",
        "label": "Spacing item",
        "default": 30
      },
      {
        "type": "range",
        "id": "spacing_sm",
        "min": 0,
        "max": 30,
        "step": 5,
        "unit": "px",
        "label": "Spacing item mobile",
        "default": 20
      },
      {
        "type": "checkbox",
        "id": "show_dots",
        "label": "Show dots slider",
        "default": true
      },
      {
        "type": "select",
        "id": "dots_color",
        "label": "Dots color",
        "default": "dots_on_light",
        "options": [
          {"value": "dots_on_light","label": "Dots on light background"},
          {"value": "dots_on_dark","label": "Dots on dark background"}
        ]
      },
      {
        "type": "checkbox",
        "id": "show_nav",
        "label": "Show nav",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_pagination_progress",
        "label": "Show pagination progress",
        "default": false
      },
      {
        "type": "color",
        "id": "pagination_progress_bg",
        "label": "Background pagination progress",
        "default": "#eaeaee"
      },
      {
        "type": "color",
        "id": "progress_bg",
        "label": "Background progress",
        "default": "#000"
      },
      {
        "type": "header",
        "content": "Background special"
      },
      {
        "type": "checkbox",
        "id": "enable_bg_special",
        "label": "Enable background special"
      },
      {
        "type": "header",
        "content": "Style Item"
      },
      {
        "type": "checkbox",
        "id": "item_max_width",
        "label": "Item max width",
        "default": false
      },
      {
        "type": "number",
        "id": "item_width",
        "label": "Item width (px)",
        "default": 250
      },
      {
        "type": "range",
        "id": "item_px",
        "min": 0,
        "max": 30,
        "step": 1,
        "label": "Padding X",
        "default": 0,
        "unit": "%"
      },
      {
        "type": "range",
        "id": "item_py",
        "min": 0,
        "max": 30,
        "step": 1,
        "label": "Padding Y",
        "default": 0,
        "unit": "%"
      },
      {
        "type": "color",
        "id": "bg_img",
        "label": "Background color",
        "default": "#f2f2f2"
      },
      {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Border radius",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "border_radius_round",
        "label": "Round item"
      },
      {
        "type": "select",
        "id": "type_hover",
        "label": "Type hover item",
        "default": "hover-imgzoom",
        "options": [
          {"value": "hover-imgzoom","label": "Image zoom"},
          {"value": "hover-shadow","label": "Show shadow"}
        ]
      },
      {
        "type": "header",
        "content": "Image Style"
      },
      {
        "type": "checkbox",
        "id": "enable_img_width",
        "label": "Enable width custom"
      },
      {
        "type": "number",
        "id": "img_width",
        "label": "Image width (px)"
      },
      {
        "type": "checkbox",
        "id": "enable_img_height",
        "label": "Enable height custom"
      },
      {
        "type": "number",
        "id": "img_height",
        "label": "Image height (px)"
      },
      {
        "type": "range",
        "id": "img_corner",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Image corner radius",
        "default": 0
      },
      {
        "type": "header",
        "content": "Border Item"
      },
      {
        "type": "checkbox",
        "id": "show_border",
        "label": "Show border"
      },
      {
        "type": "select",
        "id": "style_border",
        "label": "Border style",
        "options": [
          {
            "value": "solid",
            "label": "Solid"
          },
          {
            "value": "dashed",
            "label": "Dashed"
          },
          {
            "value": "dotted",
            "label": "Dotted"
          }
        ]
      },
      {
        "type": "color",
        "id": "c_border",
        "label": "Border color",
        "default": "#ededed"
      },
      {
        "type": "header",
        "content": "Box Shadow Item"
      },
      {
        "type": "checkbox",
        "id": "show_box_shadow",
        "label": "Show box shadow"
      },
      {
        "type": "header",
        "content": "Block Text"
      },
      {
        "type": "select",
        "id": "block_alignment",
        "label": "Alignment",
        "default": "text-left",
        "options": [
          {
            "value": "text-left",
            "label": "Left"
          },
          {
            "value": "text-center",
            "label": "Center"
          },
          {
            "value": "text-right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Heading"
      },
      {
        "type": "color",
        "id": "heading_c",
        "label": "Color",
        "default": "#222"
      },
      {
        "type": "select",
        "id": "heading_ff",
        "label": "Font family",
        "default": "f_df",
        "options": [
          {"value": "f_df","label": "Body font"},
          {"value": "f_pr","label": "Heading font"}
        ]
      },
      {
        "type": "range",
        "id": "heading_fz",
        "min": 10,
        "max": 80,
        "step": 1,
        "unit": "px",
        "label": "Font size",
        "default": 20
      },
      {
        "type": "select",
        "id": "heading_fw",
        "label": "Font weight",
        "default": "font-800",
        "options": [
          {"value": "font-300","label": "300 - Light"},
          {"value": "font-400","label": "400 - Regular"},
          {"value": "font-500","label": "500 - Medium"},
          {"value": "font-600","label": "600 - SemiBold"},
          {"value": "font-700","label": "700 - Bold"},
          {"value": "font-800","label": "800 - ExtraBold"},
          {"value": "font-900","label": "900 - Black"}
        ]
      },
      {
        "type": "select",
        "id": "heading_type",
        "label": "Heading type",
        "default": "link",
        "options": [
          { "value": "link", "label": "Link" },
          { "value": "text", "label": "Text"}
        ]
      },
      {
        "type": "header",
        "content": "Description"
      },
      {
        "type": "color",
        "id": "desc_c",
        "label": "Color",
        "default": "#222"
      },
      {
        "type": "range",
        "id": "desc_fz",
        "min": 10,
        "max": 80,
        "step": 1,
        "unit": "px",
        "label": "Font size",
        "default": 14
      },
      {
        "type": "select",
        "id": "fw_desc",
        "label": "Font weight",
        "default": "font-400",
        "options": [
          {"value": "font-300","label": "300 - Light"},
          {"value": "font-400","label": "400 - Regular"},
          {"value": "font-500","label": "500 - Medium"},
          {"value": "font-600","label": "600 - SemiBold"},
          {"value": "font-700","label": "700 - Bold"},
          {"value": "font-800","label": "800 - ExtraBold"},
          {"value": "font-900","label": "900 - Black"}
        ]
      },
      {
        "type": "header",
        "content": "Button Link"
      },
      {
        "type": "checkbox",
        "id": "show_btn",
        "label": "Show button link"
      },
      {
        "type": "select",
        "id": "btn_type",
        "label": "Button type",
        "default": "text",
        "options": [
          {"value": "text","label": "Text"},
          {"value": "button","label": "Button"}
        ]
      },
      {
        "type": "color_scheme",
        "id": "btn_color",
        "label": "Button color",
        "default": "background-1"
      },
      {
        "type": "header",
        "content": "Section Style"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default":   true
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          { "value": "container", "label": "Container" },
          { "value": "container-fluid", "label": "Container fluid" },
          { "value": "container-full", "label": "Container full width" }
        ]
      },
      {
        "type": "text",
        "id": "class_section",
        "label": "Class"
      },
      {
        "type":  "header",
        "content": "Section Background"
      },
      {
        "type": "checkbox",
        "id": "ss_bg_enable",
        "label": "Enable"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colors",
        "default": "#ffffff",
        "visible_if": "{{ section.settings.ss_bg_enable == true }}"
      },
      {
        "type": "image_picker",
        "id": "background_image",
