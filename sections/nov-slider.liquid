{%- liquid
  assign sst = section.settings
  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if sst.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}
{%- style -%}
  {% render 'nov-section-style' %}
  
  {% if sst.show_nav %}
    #shopify-section-{{ section.id }} .nav-arrow {
      --slider-arrow-color: {{ sst.slider_arrow_color }};
      --slider-arrow-color-act: {{ sst.slider_arrow_color_act }};
    }
  {% endif %}
  @media (min-width: 1200px) {
    #shopify-section-{{ section.id }} .slick-list {
      padding-inline-start: {{ sst.padding_left_xl }}vw;
      padding-inline-end: {{ sst.padding_right_xl }}vw;
      margin-inline-start: {{ sst.margin_left_xl }}vw;
      margin-inline-end: {{ sst.margin_right_xl }}vw;
    }
  }
  @media (min-width: 992px) and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .slick-list {
      padding-inline-start: {{ sst.padding_left_lg }}vw;
      padding-inline-end: {{ sst.padding_right_lg }}vw;
      margin-inline-start: {{ sst.margin_left_lg }}vw;
      margin-inline-end: {{ sst.margin_right_lg }}vw;
    }
  }
  @media (min-width: 768px) and (max-width: 991px) {
    #shopify-section-{{ section.id }} .slick-list {
      padding-inline-start: {{ sst.padding_left_md }}vw;
      padding-inline-end: {{ sst.padding_right_md }}vw;
      margin-inline-start: {{ sst.margin_left_md }}vw;
      margin-inline-end: {{ sst.margin_right_md }}vw;
    }
  }
  @media (min-width: 576px) and (max-width: 767px) {
    #shopify-section-{{ section.id }} .slick-list {
      padding-inline-start: {{ sst.padding_left_sm }}vw;
      padding-inline-end: {{ sst.padding_right_sm }}vw;
      margin-inline-start: {{ sst.margin_left_sm }}vw;
      margin-inline-end: {{ sst.margin_right_sm }}vw;
    }
  }
  @media (max-width: 575px) { 
    #shopify-section-{{ section.id }} .slick-list {
      padding-inline-start: {{ sst.padding_left_xs }}vw;
      padding-inline-end: {{ sst.padding_right_xs }}vw;
      margin-inline-start: {{ sst.margin_left_xs }}vw;
      margin-inline-end: {{ sst.margin_right_xs }}vw;
    }
  }
{%- endstyle -%}

<div class="container-outer{{ bg_class_full }} color-{{ sst.color_section }}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}{% if sst.animate %} wow fadeInUp{% endif %}">
      {% render 'heading-section', sub_position: sst.subheading_position %}
      <div class="position-relative">
        <div class="nov-slick-carousel row spacing-{{ sst.spacing }} spacing-md-{{ sst.spacing_md }}"
          data-autoplay="{{ sst.autoplay }}" 
          data-loop="{{ sst.loop }}"
          data-dots="{{ sst.show_dots }}"
          data-nav="{{ sst.show_nav }}"
          data-row_mobile="1"
          data-items_xxl="{{ sst.xxl }}"
          data-items_xl="{{ sst.xl }}"
          data-items_lg="{{ sst.lg }}"
          data-items_md="{{ sst.md }}"
          data-items_sm="{{ sst.sm }}"
          data-items_xs="{{ sst.xs }}"
          data-speed="700"
          data-custnav>
            {% content_for 'blocks' %}
        </div>
      </div>
      {% if sst.show_nav or sst.show_dots %}
        <div class="slider-direction d-flex align-items-center justify-content-center {{ sst.dots_color }} mt-60">
          {% if sst.show_nav %}
            <div class="nav-arrow nav-prev pointer">
              {% render 'icon-arrow-left' %}
            </div>
          {% endif %}
          {% if sst.show_dots %}
            <div class="append-dots"></div>
          {% endif %}
          {% if sst.show_nav %}
            <div class="nav-arrow nav-next pointer">
              {% render 'icon-arrow-right' %}
            </div>
          {% endif %}
        </div>
      {% endif %}
      {% if sst.direction_number_with_text_enable %}
        <div class="direction-number-with-text d-md-flex justify-content-center position-relative mt-80 mt-md-40 color-{{ sst.color_direction_number_with_text }}">
          {% for i in (1..6) %}
            {% assign title = 'direction_number_with_title' | append: i %}
            {% assign text = 'direction_number_with_text' | append: i %}
            {% if sst[title] != blank or sst[text] != blank %}
              <div class="item col text-md-center d-flex d-md-block nov-slick-dot position-relative {% if forloop.last == false %} mb-sm-20{% endif %}{% if forloop.first %} current{% endif %}" data-index="{{ forloop.index0 }}">
                <div class="item-number position-relative">
                  {{ i }}
                </div>
                <div class="item-content mt-35 mt-md-0">
                  {% if sst[title] != blank %}
                    <div class="item-title color-title font-700 f_pr">{{ sst[title] }}</div>
                  {% endif %}
                  {% if sst[text] != blank %}
                    <div class="item-text color-text{% if sst[title] != blank %} mt-5{% endif %}">{{ sst[text] }}</div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
