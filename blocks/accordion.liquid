{%- assign bst = block.settings -%}
{% style %}
  #shopify-{{ block.id }} .nov-accordion__item {
    border-radius: {{ bst.corner_radius }}px;
    padding: {{ bst.padding | minus: 4 }}px {{ bst.padding }}px;
  }
  #shopify-{{ block.id }} .block {
    padding-top: {{ bst.padding }}px;
    margin-top: {{ bst.padding }}px;
  }
  #shopify-{{ block.id }} .block:before {
    width: calc(100% + {{ bst.padding | times: 2 }}px);
    left: calc(-{{ bst.padding }}px);
  }
  #shopify-{{ block.id }} .nov-accordion {
    max-width: {{ bst.max_width }}px;
    margin-inline: auto;
  }
{% endstyle %}
<div id="shopify-{{ block.id }}" class="theme-blocks-item accordion-block color-{{ bst.color }}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;">
  <div class="block_accordion">
    <div class="nov-accordion{% if bst.first_open %} first-open{% endif %}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>
  
{% schema %}
  {
    "name": "Accordion",
    "tag": null,
    "blocks": [
      {
        "type": "_accordion-item"
      }
    ],
    "settings": [
      {
        "type": "checkbox",
        "id": "first_open",
        "label": "First item open",
        "default": true
      },
      {
        "type": "header",
        "content": "Style Accordion"
      },
      {
        "type": "color_scheme",
        "id": "color",
        "label": "Color",
        "default": "background-1"
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "px",
        "label": "Corner radius item",
        "default": 5
      },
      {
        "type": "range",
        "id": "padding",
        "min": 0,
        "max": 60,
        "step": 1,  
        "unit": "px",
        "label": "Padding item",
        "default": 10
      },
      {
        "type": "number",
        "id": "max_width",
        "label": "Max width",
        "default": 1920,
        "info": "Unit: px"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 30
      }
    ],
    "presets": [
      {
        "name": "Accordion"
      }
    ]
  }
{% endschema %}