{%- assign bst = block.settings -%}
<div class="theme-blocks-item button-block color-{{ bst.color_scheme }}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;">
  <a href="{{ bst.link | default: '#' }}" class="btn {{ bst.button_size }} {{ bst.button_type_color }}">
  <span>{{ bst.button_label }}</span>
  {% if bst.show_arrow %}
    <i class="zmdi zmdi-long-arrow-right"></i>
  {% endif %}
  </a>
</div>
  
{% schema %}
  {
    "name": "Button",
    "settings": [
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Shop Now"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      },
      {
        "type": "checkbox",
        "id": "show_arrow",
        "label": "Show arrow",
        "default": false
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "background-1"
      },
      {
        "type": "select",
        "id": "button_size",
        "label": "Button size",
        "options": [
          { "value": "btn-normal", "label": "Normal" },
          { "value": "btn-medium", "label": "Medium" },
          { "value": "btn-large", "label": "Large" }
        ],
        "default": "btn-normal"
      },
      {
        "type": "select",
        "id": "button_type_color",
        "label": "Button type color",
        "options": [
          { "value": "btn-primary", "label": "Primary" },
          { "value": "btn-secondary", "label": "Secondary" }
        ],
        "default": "btn-primary"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 0
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 0,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 0,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 0,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Button"
      }
    ]
  }
{% endschema %}