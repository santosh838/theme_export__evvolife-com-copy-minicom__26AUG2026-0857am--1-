{%- assign bst = block.settings -%}
<div class="card-item">
  <div class="card-image">
    {% if bst.image != blank %}
      {% render 'nov-aspect-image', image: bst.image %}
    {% else %}
      <div class="placeholder-image">
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}
  </div>
  <div class="card-content position-relative">
    {% if bst.title != blank %}
      <div class="card-title f_pr">
        {{ bst.title }}
      </div>
    {% endif %}
    {% if bst.text != blank %}
      <div class="card-text">
        {{ bst.text }}
      </div>
    {% endif %}
    {% if bst.show_button %}
      <div class="card-button position-absolute">
        <a href="{{ bst.link }}" class="d-flex align-items-center justify-content-center">
          <i class="zmdi zmdi-long-arrow-right"></i>
        </a>
        {% if bst.button_pattern %}
          {% render 'pattern-radius' %}
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
  
{% schema %}
  {
    "name": "Card Item",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "richtext",
        "id": "title",
        "label": "Title",
        "default": "<p>Card Title</p>"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Text",
        "default": "Card Text"
      },
      {
        "type": "checkbox",
        "id": "show_button",
        "label": "Show button",
        "default": false,
        "info": "Enable to show the button"
      },
      {
        "type": "checkbox",
        "id": "button_pattern",
        "label": "Enable pattern for button",
        "default": true,
        "visible_if": "{{ block.settings.show_button == true }}"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      }
    ],
    "presets": [
      {
        "name": "Card Item"
      }
    ]
  }
{% endschema %}