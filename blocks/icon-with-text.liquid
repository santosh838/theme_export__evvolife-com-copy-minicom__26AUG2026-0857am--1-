{%- assign bst = block.settings -%}
<div class="theme-blocks-item icon-with-text-block{% if bst.display_flex %} d-flex align-items-{{ bst.align }}{% endif %}" style="--gap: {{ bst.gap }}px;--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px; --item-padding: {{ bst.item_padding }}px; --item-radius: {{ bst.item_radius }}px; --bg-color: {{ bst.bg_color }}; --bg-color-hover: {{ bst.bg_color_hover }}; --color-text-hover: {{ bst.text_color_hover }}">
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Icon With Text",
  "tag": null,
  "blocks": [
    {
      "type": "icon"
    },
    {
      "type": "text"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "display_flex",
      "label": "Display Flex",
      "default": false,
      "info": "If true, the icon and text will be displayed in the same row."
    },
    {
      "type": "select",
      "id": "align",
      "label": "Align",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.display_flex == true }}"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Gap",
      "default": 10
    },
    {
      "type": "color",
      "id": "bg_color",
      "alpha": true,
      "label": "Background",
      "default": "#00000000"
    },
    {
      "type": "color",
      "id": "bg_color_hover",
      "alpha": true,
      "label": "Background hover",
      "default": "#00000000"
    },
    {
      "type": "color",
      "id": "text_color_hover",
      "label": "Text color hover",
      "default": "#000"
    },
    {
      "type": "number",
      "id": "item_padding",
      "label": "Item padding",
      "default": 0,
      "info": "Padding for each item"
    },
    {
      "type": "range",
      "id": "item_radius",
      "label": "Item border radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing Top (px)"
    },
    {
      "type": "number",
      "id": "mt_xl",
      "label": "Large laptop",
      "default": 30,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mt_lg",
      "label": "Laptop",
      "default": 30,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mt_md",
      "label": "Tablet",
      "default": 30,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mt_sm",
      "label": "Mobile",
      "default": 30
    },
    {
      "type": "header",
      "content": "Spacing Bottom (px)"
    },
    {
      "type": "number",
      "id": "mb_xl",
      "label": "Large laptop",
      "default": 30,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mb_lg",
      "label": "Laptop",
      "default": 30,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mb_md",
      "label": "Tablet",
      "default": 30,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mb_sm",
      "label": "Mobile",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Icon With Text",
      "blocks": {
          "icon-1": {
            "type": "icon"
          },
          "text-1": {
            "type": "text"
          }
        },
        "block_order": ["icon-1", "text-1"]
    }
  ]
}
{% endschema %}