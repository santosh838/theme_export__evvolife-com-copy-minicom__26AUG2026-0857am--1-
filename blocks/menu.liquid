{%- assign bst = block.settings -%}
<div class="theme-blocks-item menu-block color-{{ bst.color_scheme }}" style="--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;">
  {% if bst.block_title != blank %}
    <div class="title-block color-title fs-{{ bst.title_font_size }} font-700 f_pr mb-20 position-relative{% if bst.h_t %} d-sm-none{% endif %}">
      {{ bst.block_title }}
      {% if bst.mobile_acc %}
        <span class="f_btn_sl d-sm-none"><i class="zmdi zmdi-plus"></i></span>
      {% endif %}
    </div>
  {% endif %}
  <div class="block-content{% if bst.block_title != blank and bst.mobile_acc %} h_t{% endif %}{% if bst.animate %} wow fadeInUp{% endif %}">
    {%- assign footer_linklist = bst.menu_handle -%}
    {% if linklists[footer_linklist].links.size > 0 %}
      <ul class="linklist list-unstyled text-{{ bst.link_text_transform }} fs-{{ bst.link_font_size }}{% if bst.mobile_acc %} pb-xs-30{% endif %}">
        {% for link in linklists[footer_linklist].links %}
          <li class="linklist-item">
            <a href="{{ link.url }}">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% schema %}
  {
    "name": "Menu",
    "tag": null,
    "settings": [
      {
        "type": "text",
        "id": "block_title",
        "label": "Title"
      },
      {
        "type": "checkbox",
        "id": "mobile_acc",
        "label": "Mobile accordion",
        "visible_if": "{{ block.settings.block_title != blank }}"
      },
      {
        "type": "link_list",
        "id": "menu_handle",
        "label": "Choose menu"
      },
      {
        "type": "header",
        "content": "Link Style"
      },
      {
        "type": "number",
        "id": "title_font_size",
        "label": "Title font size",
        "default": 16
      },
      {
        "type": "number",
        "id": "link_font_size",
        "label": "Link font size",
        "default": 14
      },
      {
        "type": "select",
        "id": "link_text_transform",
        "label": "Link text transform",
        "default": "capitalize",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          },
          {
            "value": "capitalize",
            "label": "Capitalize"
          }
        ]
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "background-1"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 30
      }
    ],
    "presets": [
      {
        "name": "Menu"
      }
    ]
  }
{% endschema %}