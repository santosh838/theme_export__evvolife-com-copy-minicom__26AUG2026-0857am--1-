{%- assign bst = block.settings -%}
<div class="theme-blocks-item text-block text-{{ bst.alignment }} {{ bst.font_family }} {{ bst.font_weight }} fs-{{ bst.font_size_xxl }} fs-xl-{{ bst.font_size_xl }} fs-lg-{{ bst.font_size_lg }} fs-md-{{ bst.font_size_md }} fs-sm-{{ bst.font_size_sm }} fs-xs-{{ bst.font_size_xs }}" style="color: {{ bst.color }};--color-link: {{ bst.color_link }};--color-link-hover: {{ bst.color_link_hover }}; letter-spacing: {{ bst.letter_spacing }}px; line-height: {{ bst.line_height }};--max-width: {{ bst.max_w }}px;--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;">
  {%- if bst.icon != blank -%}
    <div class="icon-text {{ bst.icon_position }}" style="width: {{ bst.icon_size }}px;">
      {% render 'nov-aspect-image', image: bst.icon, aspect: '11' %}
    </div>
  {%- endif -%}
  {{ bst.text }}
</div>

{% schema %}
{
  "name": "Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 30,
      "visible_if": "{{ block.settings.icon != blank }}"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "value": "icon-top", "label": "Top" },
        { "value": "icon-left", "label": "Left" }
      ],
      "default": "icon-top",
      "visible_if": "{{ block.settings.icon != blank }}"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quos.</p>"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_link",
      "label": "Color link",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "color_link_hover",
      "label": "Color link hover",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font family",
      "options": [
        { "value": "f_df", "label": "Body font" },
        { "value": "f_pr", "label": "Heading font" }
      ],
      "default": "f_df"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {"value": "font-100","label": "Thin - 100"},
        {"value": "font-300","label": "Light - 300"},
        {"value": "font-400","label": "Regular - 400"},
        {"value": "font-500","label": "Medium - 500"},
        {"value": "font-600","label": "SemiBold - 600"},
        {"value": "font-700","label": "Bold - 700"},
        {"value": "font-800","label": "ExtraBold - 800"},
        {"value": "font-900","label": "Black - 900"}
      ],
      "default": "font-400"
    },
    {
      "type": "text",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "default": "0",
      "info": "Unit: px"
    },
    {
      "type": "text",
      "id": "line_height",
      "label": "Line height",
      "default": "1.5"
    },
    {
      "type": "number",
      "id": "max_w",
      "label": "Max width",
      "default": 960,
      "info": "Unit: px"
    },
    {
      "type": "header",
      "content": "Font Size",
      "info": "Unit: px"
    },
    {
      "type": "range",
      "id": "font_size_xxl",
      "label": "Desktop",
      "info": "Breakpoint 1441px ↑",
      "min": 7,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_xl",
      "label": "Large laptop",
      "info": "Breakpoint 1200px ↑",
      "min": 7,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_lg",
      "label": "Laptop",
      "info": "Breakpoint 992px ↑",
      "min": 7,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_md",
      "label": "Tablet",
      "info": "Breakpoint 768px ↑",
      "min": 7,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_sm",
      "label": "Large mobile",
      "info": "Breakpoint 576px ↑",
      "min": 7,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_xs",
      "label": "Mobile",
      "min": 7,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Spacing Top (px)"
    },
    {
      "type": "number",
      "id": "mt_xl",
      "label": "Large laptop",
      "default": 0,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mt_lg",
      "label": "Laptop",
      "default": 0,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mt_md",
      "label": "Tablet",
      "default": 0,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mt_sm",
      "label": "Mobile",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing Bottom (px)"
    },
    {
      "type": "number",
      "id": "mb_xl",
      "label": "Large laptop",
      "default": 10,
      "info": "Breakpoint 1200px"
    },
    {
      "type": "number",
      "id": "mb_lg",
      "label": "Laptop",
      "default": 10,
      "info": "Breakpoint 992px"
    },
    {
      "type": "number",
      "id": "mb_md",
      "label": "Tablet",
      "default": 10,
      "info": "Breakpoint 768px"
    },
    {
      "type": "number",
      "id": "mb_sm",
      "label": "Mobile",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Text"
    }
  ]
}
{% endschema %}