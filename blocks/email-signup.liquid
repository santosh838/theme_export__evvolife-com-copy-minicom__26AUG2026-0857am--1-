{%- assign bst = block.settings -%}
{% style %}
  #shopify-block-{{ block.id }} {
    --input-color: {{ bst.input_color }};
    --input-place-color: {{ bst.input_place_color }};
    --input-bg: {{ bst.input_bg }};
    --input-border-color: {{ bst.input_border_color }};
  }
{% endstyle %}
<div id="shopify-block-{{ block.id }}" class="email-signup-block">
  {% form 'customer', id: block.id %}
    {{ form.errors | default_errors }}
    {% if form.posted_successfully? %}
      <p class="form--success text-center">{{ 'general.newsletter_form.confirmation' | t }}</p>
    {% else %}
      <div class="input-group position-relative">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email"
          name="contact[email]"
          id="Email_Footer"
          class="input form-control"
          value="{% if customer %}{{ customer.email }}{% endif %}"
          placeholder="{{ 'general.newsletter_form.email_newsletter' | t }}"
          required>
          <button type="submit" name="commit" class="btn pointer color-{{ bst.submit_color }} {{ bst.submit_btn_type }}">
            <span class="position-relative d-flex align-items-center justify-content-center">
              {% if bst.btn_text_arrow == 'text' or bst.btn_text_arrow == 'text_arrow' %}
                {{ bst.btn_label }}
              {% endif %}
              {% if bst.btn_text_arrow == 'arrow' or bst.btn_text_arrow == 'text_arrow' %}
                <i class="zmdi zmdi-long-arrow-right"></i>
              {% endif %}
            </span>
          </button>
      </div>
    {% endif %}
  {% endform %}
  </div>
{% schema %}
  {
    "name": "Email Signup",
    "tag": null,
    "settings": [
      {
        "type": "color",
        "id": "input_color",
        "label": "Input color",
        "default": "#000"
      },
      {
        "type": "color",
        "id": "input_place_color",
        "label": "Input placeholder color",
        "default": "#666"
      },
      {
        "type": "color",
        "id": "input_bg",
        "label": "Input background",
        "default": "#d2d2d2"
      },
      {
        "type": "color",
        "id": "input_border_color",
        "label": "Border color",
        "default": "#d2d2d2"
      },
      {
        "type": "header",
        "content": "Button"
      },
      {
        "type": "color_scheme",
        "id": "submit_color",
        "label": "Button submit color",
        "default": "background-1"
      },
      {
        "type": "select",
        "id": "submit_btn_type",
        "label": "Submit type color",
        "default": "btn-primary",
        "options": [
          { "value": "btn-primary", "label": "Primary" },
          { "value": "btn-secondary", "label": "Secondary" }
        ]
      },
      {
        "type": "select",
        "id": "btn_text_arrow",
        "label": "Button text or arrow",
        "options": [
          { "value": "text", "label": "Text" },
          { "value": "arrow", "label": "Arrow" },
          { "value": "text_arrow", "label": "Text and Arrow" }
        ],
        "default": "text"
      },
      {
        "type": "text",
        "id": "btn_label",
        "label": "Button label",
        "default": "Subscribe"
      }
    ],
    "presets": [
      {
        "name": "Email Signup"
      }
    ]
  }
  {% endschema %}
  