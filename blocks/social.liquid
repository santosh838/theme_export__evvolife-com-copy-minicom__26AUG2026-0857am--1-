{%- assign bst = block.settings -%}
<div class="theme-blocks-item social-block color-{{ bst.color_section }} {{ bst.social_type_color }}" style="--size: {{ bst.size }}px; --radius: {{ bst.radius }}px;--gap: {{ bst.gap | divided_by: 2 }}px;--mt-xl: {{ bst.mt_xl }}px; --mt-lg: {{ bst.mt_lg }}px; --mt-md: {{ bst.mt_md }}px; --mt-sm: {{ bst.mt_sm }}px; --mb-xl: {{ bst.mb_xl }}px; --mb-lg: {{ bst.mb_lg }}px; --mb-md: {{ bst.mb_md }}px; --mb-sm: {{ bst.mb_sm }}px;">
  {% render 'nov-social' %}
</div>

{% schema %}
  {
    "name": "Social",
    "settings": [
      {
        "type": "number",
        "id": "size",
        "label": "Size",
        "default": 40,
        "info": "Unit: px"
      },
      {
        "type": "number",
        "id": "radius",
        "label": "Radius",
        "default": 99,
        "info": "Unit: px"
      },
      {
        "type": "color_scheme",
        "id": "color_section",
        "label": "Color section",
        "default": "background-1"
      },
      {
        "type": "select",
        "id": "social_type_color",
        "label": "Social type color",
        "options": [
          {
          "value": "btn-primary",
          "label": "Primary"
          },
          {
            "value": "btn-secondary",
            "label": "Secondary"
          }
        ],
        "default": "btn-primary"
      },
      {
        "type": "number",
        "id": "gap",
        "label": "Gap",
        "default": 10,
        "info": "Unit: px"
      },
      {
        "type": "header",
        "content": "Spacing Top (px)"
      },
      {
        "type": "number",
        "id": "mt_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mt_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mt_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mt_sm",
        "label": "Mobile",
        "default": 30
      },
      {
        "type": "header",
        "content": "Spacing Bottom (px)"
      },
      {
        "type": "number",
        "id": "mb_xl",
        "label": "Large laptop",
        "default": 30,
        "info": "Breakpoint 1200px"
      },
      {
        "type": "number",
        "id": "mb_lg",
        "label": "Laptop",
        "default": 30,
        "info": "Breakpoint 992px"
      },
      {
        "type": "number",
        "id": "mb_md",
        "label": "Tablet",
        "default": 30,
        "info": "Breakpoint 768px"
      },
      {
        "type": "number",
        "id": "mb_sm",
        "label": "Mobile",
        "default": 30
      }
    ],
    "presets": [
      {
        "name": "Social"
      }
    ]
  }
{% endschema %}